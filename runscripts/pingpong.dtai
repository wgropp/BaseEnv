#!/bin/bash
#SBATCH --mem=16g
#SBATCH --nodes=2
#SBATCH --ntasks-per-node=1  # 1 per node
#SBATCH --cpus-per-task=1    # <- match to OMP_NUM_THREADS
#SBATCH --partition=ghx4
#SBATCH --account=bbka-dtai-gh
#SBATCH --job-name=pingpong
# For debugging, only needs a short amount of time
#SBATCH --time=00:05:00      # hh:mm:ss for the job
### GPU options ###
#SBATCH --gpus-per-node=1
##SBATCH --gpu-bind=none     # <- or closest

module list  # job documentation and metadata
module load nvhpc
echo "job is starting on `hostname`"
srun ./pingpong -ntrials 20 -ntest-info -ntest-wt 1000.0 -ntest-min 2 -sizes 1:1100000\*2 -o pingpong.txt -check > pingpong-out.txt
echo "Starting MPI from cuda memory test"
srun ./pingpong -ntrials 20 -ntest-info -ntest-wt 1000.0 -ntest-min 2 -sizes 1:1100000\*2 -memtype cuda -o pingpong-cuda-data.txt -check -checkonhost > pingpong-cuda-out.txt
